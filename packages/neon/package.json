{
  "name": "@fin-kit/neon",
  "version": "0.1.0",
  "description": "Neon WebSocket storage adapter for fin-kit.",
  "homepage": "https://github.com/iianjun/fin#readme",
  "bugs": {
    "url": "https://github.com/iianjun/fin/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iianjun/fin.git",
    "directory": "packages/neon"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node --input-type=commonjs -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && pnpm build"
  },
  "dependencies": {
    "@fin-kit/provider": "workspace:*",
    "@neondatabase/serverless": "1.2.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
