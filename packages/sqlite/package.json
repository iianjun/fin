{
  "name": "@fin-kit/sqlite",
  "version": "0.1.0",
  "description": "Local SQLite storage adapter for fin-kit.",
  "homepage": "https://github.com/iianjun/fin#readme",
  "bugs": {
    "url": "https://github.com/iianjun/fin/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iianjun/fin.git",
    "directory": "packages/sqlite"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node --input-type=commonjs -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && pnpm build"
  },
  "dependencies": {
    "@fin-kit/provider": "workspace:*",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  },
  "engines": {
    "node": ">=24"
  }
}
