{
  "name": "fin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "check": "pnpm format:check",
    "prepare": "lefthook install",
    "hooks:check": "lefthook run pre-commit"
  },
  "devDependencies": {
    "lefthook": "2.1.10",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.14.0"
}
