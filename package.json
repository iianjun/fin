{
  "name": "fin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --fail-if-no-match -r build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && vitest run",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && vitest run",
    "example": "pnpm build && node apps/example/sqlite.mjs",
    "example:d1": "pnpm build && node apps/example/d1.mjs",
    "prepare": "lefthook install",
    "hooks:check": "lefthook run pre-commit",
    "build:example:worker": "pnpm build && esbuild apps/example/mcp-worker.mjs --bundle --format=esm --platform=browser --conditions=workerd --outfile=apps/example/dist/mcp-worker.mjs",
    "test:turso:hosted": "pnpm build && node packages/turso/test/hosted.mjs",
    "test:supabase:local": "pnpm build && node packages/supabase/test/verify.mjs local",
    "test:supabase:hosted": "pnpm build && node packages/supabase/test/verify.mjs hosted",
    "verify:postgres": "node -e \"if (!process.env.FIN_POSTGRES_URL) throw new Error('Set FIN_POSTGRES_URL to a dedicated PostgreSQL test server with CREATEDB permission')\" && pnpm build && vitest run packages/postgres packages/core/src/fin.test.ts packages/tools/src/consumer.test.ts"
  },
  "devDependencies": {
    "@fin/core": "workspace:*",
    "@fin/d1": "workspace:*",
    "@fin/postgres": "workspace:*",
    "@fin/sqlite": "workspace:*",
    "@fin/tools": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "lefthook": "2.1.10",
    "miniflare": "4.20260730.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.14.0"
}
